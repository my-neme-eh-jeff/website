# pnpm settings. Committed, so every machine and CI agree.

# Do not run dependency lifecycle scripts (postinstall and friends).
#
# This is pnpm 10's default, but it is stated explicitly because it is a
# security property, not a preference: a postinstall script runs arbitrary code
# from a transitive dependency at install time, which is the most common
# software-supply-chain delivery mechanism. npm runs them all by default.
#
# This project builds with ZERO approved scripts. pnpm reports four candidates
# (esbuild, sharp, workerd, @parcel/watcher). sharp runs in the build, for the
# blog's `?jsx` cover images, and esbuild in `wrangler deploy`, which bundles
# the Worker with it; each loads its prebuilt platform package, which needs no
# script. workerd and @parcel/watcher are unused here or only needed by tooling
# this build never invokes. Verified by a clean `pnpm run build`. If something
# ever genuinely needs one, add it to `pnpm.onlyBuiltDependencies` in
# package.json rather than turning this off.
side-effects-cache=false
