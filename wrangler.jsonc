{
  // Asset requests are free and unlimited; a Worker invocation counts against
  // the 100k/day free tier, so run_worker_first lists /api/* paths, never `true`.
  //
  // `wrangler deploy` runs build.command, and Workers Builds deploys with
  // `npx wrangler deploy`, so the build is versioned here. Leave the dashboard's
  // build command empty, or it builds twice.
  "build": {
    "command": "pnpm install --frozen-lockfile && pnpm run build",
  },
  // The Worker in Cloudflare. Workers Builds deploys to it whatever this says,
  // so a mismatch only bites a laptop deploy, which would create a second
  // Worker. Check: `wrangler deployments list --name website` (2026-10-19).
  "name": "website",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    // Serves dist/404.html for unmatched paths, so src/routes/404.tsx stays a
    // file route: a directory route emits dist/404/index.html.
    "not_found_handling": "404-page",
    // Explicit, so a change to Cloudflare's default can't split /blog from
    // /blog/, the form the canonical URLs use.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // The log proxy in desk/ (port 11500), through a Cloudflare Tunnel. Workers
  // VPC is beta and free on all plans (developers.cloudflare.com/workers-vpc,
  // read 2026-10-13). Check: `wrangler vpc service get <service_id>`.
  "vpc_services": [
    { "binding": "DESK", "service_id": "01a13600-e2dd-7483-83a1-5560fe691686" },
  ],
  // Per-IP and per-location, so approximate by design. A human cannot ask
  // faster than the model answers; this is for scripts.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 },
    },
    // Poe answers when the desk can't, on Aman's points: one shared key, so
    // this caps them for everyone (per location, so still approximate).
    {
      "name": "POE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
    // `ping desk` and `traceroute desk`: three probes a command, a second apart.
    {
      "name": "PING_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // POE_API_KEY is a secret, set with `wrangler secret put` on the desk.
  "vars": {
    "DESK_MODEL": "gemma4:26b-a4b-it-qat",
    "POE_MODEL": "ds-v4.1-flash-1017",
  },
  "routes": [
    {
      "pattern": "amannambisan.com",
      "custom_domain": true,
    },
  ],
}
