# Cloudflare applies every matching rule and comma-joins a header two rules
# set, so Cache-Control stays out of the `/*` catch-all. `pnpm run verify` checks.

# Content-hashed by Qwik, so immutable.
/build/*
  Cache-Control: public, max-age=31556952, immutable

/assets/*
  Cache-Control: public, max-age=31556952, immutable

# Not content-hashed (markup names them), so a week rather than immutable.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=604800

# Immutable: each filename carries its Google Fonts version.
/fonts/*.woff2
  Cache-Control: public, max-age=31556952, immutable
  Access-Control-Allow-Origin: *

# HTML keeps Cloudflare's default, `max-age=0, must-revalidate`, so a deploy
# shows at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

  # Nothing here uses these; denying them stops a future dependency asking.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # No `preload`: submitting to the preload list is effectively irreversible.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # No CSP here: scripts/csp.mjs appends one per page to dist/_headers, and a
  # page must satisfy every CSP it is sent.
