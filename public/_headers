# Parsed by Cloudflare Workers static assets. Lives in public/ so Qwik's build
# copies it into dist/ alongside the assets it describes.
#
# Workers defaults every asset to `max-age=0, must-revalidate`, which is safe
# but means a revalidation round trip for files that can never change.
#
# Rules are matched most-specific-first, so the narrow cache rules must come
# before the catch-all `/*` block.

# Qwik emits content-hashed filenames here, so the content is immutable by
# construction: a change produces a new filename.
/build/*
  Cache-Control: public, max-age=31556952, immutable

/assets/*
  Cache-Control: public, max-age=31556952, immutable

# Icons and social cards are NOT content-hashed — the filename is referenced
# from markup and must stay stable — so `immutable` would be wrong: a favicon
# change could never propagate. A week of caching with revalidation after is
# the compromise, and it still removes the round trip from the common case.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=604800

# Fonts CAN be immutable, unlike the icons above: their filenames carry the
# upstream Google Fonts version (v12, v16), so a font update produces a new
# URL rather than needing an old one to expire. See scripts/fetch-fonts.mjs.
/fonts/*.woff2
  Cache-Control: public, max-age=31556952, immutable
  Access-Control-Allow-Origin: *

# HTML keeps the safe default so a deploy is visible immediately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

  # Nothing on this site reads a camera, mic, or location. Denying them by
  # default means a future dependency cannot quietly start asking.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # The apex is served over TLS only and the domain is Cloudflare-registered,
  # so there is no plaintext host to break. `preload` is deliberately omitted:
  # submitting to the preload list is effectively irreversible, and it would
  # commit every future subdomain to HTTPS as well.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # No CSP here on purpose: Qwik's resumability relies on inline scripts, so a
  # strict policy needs nonce or hash plumbing rather than a one-line guess.
  # Tracked as an open item in the README.
